# Runtime environment name for the service.
NODE_ENV=development
# HTTP port exposed by the API container.
PORT=8000
# Interface on which the HTTP server listens.
HOST=0.0.0.0
# Minimum log severity emitted by Fastify and Pino.
LOG_LEVEL=info
# PostgreSQL connection string used for readiness checks.
DATABASE_URL=postgres://ix:ix@postgres:5432/ix
# Public URL used when the service builds external links.
PUBLIC_BASE_URL=http://localhost:8000
# Enables simulation-only behaviour in later phases.
SIMULATION_MODE=true
# Apply pending database migrations automatically before the API listens.
DB_AUTO_MIGRATE=true
# Optional bearer token for protected API routes; empty disables authentication.
API_TOKEN=
# Separate database used only by Jest integration tests.
TEST_DATABASE_URL=postgres://ix:ix@postgres:5432/ix_test
# Number of hours a completed idempotency key is retained.
IDEMPOTENCY_TTL_HOURS=24
# Maximum milliseconds a duplicate request waits for the first request.
IDEMPOTENCY_WAIT_MS=5000
# Seconds before an unfinished idempotency claim is treated as abandoned.
IDEMPOTENCY_LOCK_TTL_SECONDS=60
# Apply pending database migrations automatically before the API listens.
DB_AUTO_MIGRATE=true
# Optional bearer token for protected API routes; empty disables authentication.
API_TOKEN=
# Separate database used only by Jest integration tests.
TEST_DATABASE_URL=postgres://ix:ix@postgres:5432/ix_test

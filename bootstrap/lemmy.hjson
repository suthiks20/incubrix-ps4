# Local Lemmy configuration used only by the optional Compose profile.
# The initial administrator is used because registered accounts are unapproved.
hostname: "localhost:8536"
bind: "0.0.0.0"
port: 8536
tls_enabled: false
database: {
  host: "lemmy-db"
  port: 5432
  database: "lemmy"
  user: "lemmy"
  password: "lemmy-spike-password"
  pool_size: 5
}
pictrs: {
  url: "http://pictrs:8080/"
}
registration_mode: "Open"
setup: {
  admin_username: "incubrixadmin"
  admin_password: "spike-lemmy-password-only-local"
  site_name: "IncuBrix Local"
}

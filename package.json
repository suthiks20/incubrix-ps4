{
  "name": "incubrix-longtail",
  "version": "1.0.0",
  "private": true,
  "description": "IncuBrix Long-Tail Destination Network connector service.",
  "main": "dist/src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc && node scripts/copyAssets.js",
    "start": "node dist/src/server.js",
    "pretest": "npm run build",
    "test": "jest --runInBand",
    "test:ci": "jest --runInBand --ci",
    "test:unit": "jest --runInBand tests/unit",
    "test:integration": "jest --runInBand tests/integration",
    "lint": "eslint .",
    "migrate": "knex --knexfile knexfile.js migrate:latest",
    "migrate:rollback": "knex --knexfile knexfile.js migrate:rollback",
    "bootstrap:local": "docker compose run --rm bootstrap",
    "certify:local": "node bootstrap/verify.js all",
    "verify:local": "node bootstrap/verify.js all",
    "certify:real": "node dist/scripts/certify-real.js",
    "seed": "npm run build && node dist/scripts/seed.js",
    "ix-batch": "node dist/scripts/ix-batch.js",
    "gen-catalogue": "node dist/scripts/gen-catalogue.js",
    "measure": "node dist/scripts/measure.js",
    "certify:mock": "node dist/scripts/certify-mock.js",
    "capture:real": "node dist/scripts/capture-real.js"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1156.0",
    "@aws-sdk/s3-request-presigner": "^3.1156.0",
    "fastify": "^5.2.1",
    "js-yaml": "^4.3.2",
    "knex": "^3.1.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "@types/jest": "^29.5.14",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0",
    "ts-jest": "^29.4.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.0"
  }
}

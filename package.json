{
  "name": "incubrix-longtail",
  "version": "1.0.0",
  "private": true,
  "description": "IncuBrix Long-Tail Destination Network connector service.",
  "main": "src/server.js",
  "engines": { "node": ">=20" },
  "scripts": {
    "start": "node src/server.js",
    "test": "jest --runInBand",
    "test:ci": "jest --runInBand --ci",
    "test:unit": "jest --runInBand tests/unit",
    "test:integration": "jest --runInBand tests/integration",
    "lint": "eslint .",
    "migrate": "knex --knexfile knexfile.js migrate:latest",
    "migrate:rollback": "knex --knexfile knexfile.js migrate:rollback"
  },
  "dependencies": {
    "fastify": "^5.2.1",
    "knex": "^3.1.0",
    "pg": "^8.13.1",
    "pino": "^9.5.0"
  },
  "devDependencies": {
    "eslint": "^9.17.0",
    "jest": "^29.7.0",
    "supertest": "^7.0.0"
  }
}
